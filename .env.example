# HR botining ichki, faqat-o'qish API manzili (internal_api.py, alohida
# Railway xizmati bo'lsa uning ichki tarmoq manzili)
HR_INTERNAL_API_BASE_URL=http://shohonaworkbot.railway.internal:8089
HR_INTERNAL_API_TOKEN=hr-internal-token-shu-yerga

# production-sync'ning o'z holat bazasi (allaqachon ko'rilgan hodisalar)
STATE_DATABASE_PATH=production_sync_state.db

# Ombor moduli API manzili. Bo'sh qoldirilsa, sync hech narsa qilmaydi.
OMBOR_API_BASE_URL=https://ombor.example.com
OMBOR_ACTOR_NAME=production-sync

# Matn->mahsulot moslashtirish ishonch chegarasi (0..1)
MATCH_THRESHOLD=0.72

# HR turli vazifalarda turli birlikda hisobot berishi mumkin (masalan ba'zi
# vazifalar "box"da, ba'zilari to'g'ridan-to'g'ri "partiya"da). Har bir
# birlik uchun 1 dona (banka)ga necha marta ko'paytirish kerakligi (JSON).
# Bo'sh qoldirilsa standart qiymat ishlatiladi: box=24, partiya=300, dona=1, ta=1
UNIT_MULTIPLIERS={"box": 24, "partiya": 300, "dona": 1, "ta": 1}

# Har nechta soniyada bir marta tekshirish
POLL_INTERVAL_SECONDS=300
